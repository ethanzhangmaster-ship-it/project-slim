{
  "_note": "App Store Connect + Google Play API 凭证 (本地存储, 禁止提交). 复制为 store_keys.json 并填入真实值.",
  "_setup_instructions": {
    "app_store_connect": {
      "step_1": "登录 App Store Connect → Users and Access → Keys",
      "step_2": "创建 API Key (需 Admin 权限), 下载 .p8 私钥文件",
      "step_3": "记录 key_id (页面上显示) 和 issuer_id (页面顶部)",
      "step_4": "将 .p8 文件内容 (含 BEGIN/END 标记) 粘贴到 private_key_p8 字段",
      "step_5": "设置 .p8 文件权限 600: chmod 600 AuthKey_XXX.p8"
    },
    "google_play": {
      "step_1": "Google Play Console → Settings → API access",
      "step_2": "创建 Service Account, 下载 JSON 密钥文件",
      "step_3": "将 JSON 文件路径填入 service_account_json_path"
    }
  },
  "_env_var_alternatives": {
    "APPSTORE_API_KEY_ID": "替代 app_store_connect.key_id",
    "APPSTORE_API_ISSUER_ID": "替代 app_store_connect.issuer_id",
    "APPSTORE_PRIVATE_KEY_P8_PATH": ".p8 文件路径 (运行时读取, 不落盘明文)"
  },

  "app_store_connect": {
    "key_id": "YOUR_API_KEY_ID",
    "issuer_id": "YOUR_ISSUER_ID",
    "private_key_p8": "-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_CONTENT_HERE\n-----END PRIVATE KEY-----"
  },

  "google_play": {
    "service_account_json_path": "/path/to/service-account.json"
  }
}
