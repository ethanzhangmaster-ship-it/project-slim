{
  "_comment": "告警通知渠道配置模板。复制为 notify.json 并填入真实凭证。环境变量优先级高于此文件。",

  "_env_var_mapping": {
    "smtp_host": "SMTP_HOST",
    "smtp_port": "SMTP_PORT",
    "smtp_user": "SMTP_USER",
    "smtp_password": "SMTP_PASSWORD",
    "email_from": "EMAIL_FROM",
    "email_to": "EMAIL_TO",
    "wecom_webhook": "WECOM_WEBHOOK",
    "feishu_alert_webhook": "FEISHU_ALERT_WEBHOOK"
  },

  "smtp_host": "smtp.example.com",
  "smtp_port": 465,
  "smtp_user": "sender@example.com",
  "smtp_password": "your-smtp-password",
  "email_from": "sender@example.com",
  "email_to": "admin1@example.com,admin2@example.com",

  "wecom_webhook": "https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR-WECOM-KEY",

  "feishu_alert_webhook": "https://open.feishu.cn/open-apis/bot/v2/hook/YOUR-FEISHU-TOKEN"
}
