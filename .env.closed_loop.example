# Closed Loop 配置文件
# 复制此文件为 .env.closed_loop 或在 .env 中添加以下配置

# ============================================================================
# 必需: Facebook 广告投放配置
# ============================================================================

# Facebook 广告账户 ID (数字, 不带 act_ 前缀)
CLOSED_LOOP_ADSET_ID=

# Facebook 主页 ID (用于创建广告创意)
CLOSED_LOOP_PAGE_ID=

# ============================================================================
# 可选: 投放参数
# ============================================================================

# 广告系列预算上限 (美元/天)
CLOSED_LOOP_DAILY_BUDGET=20

# 每轮最多生成图片数
CLOSED_LOOP_MAX_IMAGES=10

# 评分阈值 (1-10, 低于此分数的图片不会上传)
CLOSED_LOOP_SCORE_THRESHOLD=6.0

# 是否自动激活广告 (true/false, 建议上线初期用 false)
CLOSED_LOOP_AUTO_ACTIVATE=false

# ============================================================================
# 可选: 多项目配置
# ============================================================================

# 默认项目名
DEFAULT_GAME_NAME=P04 Witch

# 多项目批量 (逗号分隔)
# CLOSED_LOOP_PROJECTS=P04 Witch,P02 Mermaid,P07 Vampire

# ============================================================================
# 使用说明
# ============================================================================
# 1. 填写 CLOSED_LOOP_ADSET_ID 和 CLOSED_LOOP_PAGE_ID
# 2. 在 Facebook Ads Manager 中创建一个 adset 获取其 ID
# 3. 在 Facebook Page Settings 中获取 page ID
# 4. 运行: python3 scripts/run_full_closed_loop.py --dry-run 验证链路
# 5. 运行: python3 scripts/run_full_closed_loop.py 首次完整执行
